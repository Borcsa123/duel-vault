{
  "name": "duel-vault-desktop",
  "version": "1.0.18",
  "description": "Duel Vault – helyi Yu-Gi-Oh! gyűjteménykezelő",
  "author": "Duel Vault",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:ui": "vite build",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build:ui && electron-builder --win --x64 --dir --publish never && npm run package:installer",
    "start": "electron .",
    "updates:sign": "node scripts/sign-update.cjs",
    "dev": "node scripts/preview.cjs",
    "package:installer": "node scripts/package-installer.cjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "hu.duelvault.desktop",
    "productName": "Duel Vault",
    "copyright": "Duel Vault; card artwork © Konami",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Duel Vault",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Duel-Vault-Setup-${version}-x64.exe",
      "script": "build/installer.nsi"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
